# Copia este archivo como .env y cambia los valores. El .env real NO se sube.

# Base de datos (servicio db)
POSTGRES_DB=chispaqr
POSTGRES_USER=chispaqr_app
POSTGRES_PASSWORD=cambia_esta_clave

# API (servicio api)
API_PORT=3000
DATABASE_URL=postgres://chispaqr_app:cambia_esta_clave@db:5432/chispaqr
JWT_SECRET=cambia_este_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h
# Nivel de logs: fatal, error, warn, info, debug, silent
LOG_LEVEL=info
# Solo para `npm test` en local: base de prueba que se vacía en cada prueba
TEST_DATABASE_URL=postgres://chispaqr_app:cambia_esta_clave@localhost:5432/chispaqr_test

# Web (servicio web)
WEB_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
