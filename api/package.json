{
  "name": "chispaqr-api",
  "version": "0.2.0",
  "private": true,
  "description": "API de ChispaQR: pedidos por QR para el Recreo Chispa",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file=../.env src/server.js",
    "test": "node --test --test-concurrency=1 test/unit/*.test.js test/integracion/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "lint": "eslint .",
    "qr": "node --env-file=../.env scripts/generar-qr.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "qrcode": "^1.5.4",
    "supertest": "^7.3.1"
  }
}
